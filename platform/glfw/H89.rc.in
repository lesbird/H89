// Windows resources: the program icon (GLFW_ICON is also used for the
// window) and version information. Configured by CMake.
#include <winver.h>

GLFW_ICON ICON "@CMAKE_SOURCE_DIR@/platform/glfw/H89.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@H89_VENDOR@"
            VALUE "FileDescription", "Heathkit H89 Emulator"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "H89"
            VALUE "LegalCopyright", "@H89_COPYRIGHT@"
            VALUE "OriginalFilename", "H89.exe"
            VALUE "ProductName", "H89"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
